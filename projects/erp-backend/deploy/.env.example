# Mythos ERP secure backend — environment template.
# Copy to a host-only location (NOT committed) and inject via php-fpm /
# systemd EnvironmentFile. No secret belongs in the repository.

# --- Database -------------------------------------------------------------
# Reference driver (zero external service, ACID, WAL concurrency):
ERP_DB_DRIVER=sqlite
ERP_DB_PATH=/var/lib/erp-backend/erp.db
# Production alternative (already available on the host):
#ERP_DB_DRIVER=mysql
#ERP_DB_DSN=mysql:host=127.0.0.1;dbname=erp;charset=utf8mb4
#ERP_DB_USER=erp
#ERP_DB_PASS=__set_on_host__

# --- Storage (OUTSIDE the web root, no PHP execution) ---------------------
ERP_UPLOAD_DIR=/var/lib/erp-backend/uploads
ERP_MAX_UPLOAD_BYTES=10485760
ERP_MAX_COLLECTION_BYTES=8388608

# --- Sessions / cookies ---------------------------------------------------
ERP_COOKIE_SECURE=1            # 1 in production (HTTPS) -> __Host- cookie
ERP_SESSION_TTL_DAYS=7

# --- CORS (closed by default; set to the exact frontend origin) -----------
ERP_ALLOWED_ORIGIN=https://erp.mythosprod.xyz

# --- Optional mount prefix if served under a sub-path ---------------------
#ERP_BASE_PATH=/erp-api
