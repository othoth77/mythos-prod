  "cost": {
    "spreadModel": "instrument-typical",
    "slippageModel": "gaussian",
    "includeCommission": true,
    "includeSwap": true,
    "executionDelayBars": 0,
    "swapChargeHoursUtc": 21
  },
  "schedule": {
    "respectInstrumentHours": true,
    "blockForexWeekend": true,
    "blockedWeekdaysUtc": [],
    "perAsset": {}
  },
  "backtest": {
    "seed": "mythos-default",
    "warmupBars": 200,
    "baseTimeframe": "M15",
    "higherTimeframe": "H4",
    "maxBarsInTrade": 240,
    "allowIntrabarStopAndTarget": "STOP_FIRST"
  },
  "observability": {
    "logLevel": "INFO",
    "auditEveryCandidate": true
  }
}
