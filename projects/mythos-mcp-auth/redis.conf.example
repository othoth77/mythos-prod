# Redis replay store — template. Live file: deployments/mythos-mcp-auth/redis/redis.conf (uid 10002, 0400).
bind 0.0.0.0
protected-mode yes
port 6379
requirepass <generated>
maxmemory 32mb
maxmemory-policy noeviction
appendonly yes
appendfsync everysec
save ""
rename-command CONFIG ""
rename-command DEBUG ""
