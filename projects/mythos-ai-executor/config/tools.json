{
  "git.read": {
    "version": "1.0.0",
    "capabilities": ["repo_inspection"],
    "policy_class": "READ",
    "risk": "low",
    "provider": "builtin",
    "input_schema": {
      "type": "object", "additionalProperties": false, "required": ["repo_path"],
      "properties": { "repo_path": { "type": "string", "minLength": 1, "maxLength": 300 } }
    },
    "output_schema": {
      "type": "object",
      "properties": { "branch": { "type": ["string", "null"] }, "head": { "type": ["string", "null"] }, "dirty": { "type": "boolean" } }
    }
  },
  "filesystem.read": {
    "version": "1.0.0",
    "capabilities": ["file_inspection"],
    "policy_class": "READ",
    "risk": "low",
    "provider": "builtin",
    "input_schema": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 500 } }
    }
  },
  "web.search": {
    "version": "0.1.0",
    "capabilities": ["research"],
    "policy_class": "EXTERNAL_API",
    "risk": "low",
    "provider": "mock",
    "input_schema": {
      "type": "object", "additionalProperties": false, "required": ["query"],
      "properties": { "query": { "type": "string", "minLength": 1, "maxLength": 500 } }
    }
  },
  "image.generate": {
    "version": "0.1.0",
    "capabilities": ["image_generation"],
    "policy_class": "EXTERNAL_API",
    "risk": "medium",
    "provider": "mock",
    "input_schema": {
      "type": "object", "additionalProperties": false, "required": ["prompt"],
      "properties": { "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 } }
    }
  },
  "image.validate": {
    "version": "0.1.0",
    "capabilities": ["image_validation"],
    "policy_class": "READ",
    "risk": "low",
    "provider": "mock",
    "input_schema": {
      "type": "object", "additionalProperties": false, "required": ["image_ref"],
      "properties": { "image_ref": { "type": "string", "minLength": 1, "maxLength": 500 } }
    }
  },
  "meta.create_campaign": {
    "version": "0.1.0",
    "capabilities": ["marketing_campaign"],
    "policy_class": "MONEY_SPEND",
    "risk": "high",
    "provider": "mock",
    "input_schema": {
      "type": "object", "additionalProperties": false,
      "required": ["daily_budget_usd", "duration_days"],
      "properties": {
        "daily_budget_usd": { "type": "number", "minimum": 0, "maximum": 10000 },
        "duration_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "copy": { "type": "string", "maxLength": 10000 },
        "image_ref": { "type": "string", "maxLength": 500 }
      }
    }
  },
  "database.query": {
    "version": "0.1.0",
    "capabilities": ["data_read"],
    "policy_class": "READ",
    "risk": "medium",
    "provider": "external",
    "note": "Declarative-only until a concrete read-only adapter is wired; invoke() refuses adapterless tools."
  },
  "github.commit": {
    "version": "0.1.0",
    "capabilities": ["git_delivery"],
    "policy_class": "GIT",
    "risk": "medium",
    "provider": "external",
    "note": "Delivery happens through the Phase 1 executor pipeline + persistent relay; declarative here so planners can reason about it."
  },
  "database.destroy": {
    "version": "0.1.0",
    "capabilities": ["data_destruction"],
    "policy_class": "DESTRUCTIVE",
    "risk": "critical",
    "provider": "external",
    "note": "Exists to PROVE the deny path: policy must refuse DESTRUCTIVE always; no adapter will ever be registered."
  }
}
