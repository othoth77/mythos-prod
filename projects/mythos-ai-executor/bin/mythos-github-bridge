#!/usr/bin/env node
'use strict';
// =====================================================
// MYTHOS GitHub control bridge — CLI
// projects/mythos-ai-executor/bin/mythos-github-bridge
//
//   mythos-github-bridge init                bootstrap the control branch worktree (idempotent)
//   mythos-github-bridge tick                one pass: sync, claim, progress, report, commit
//   mythos-github-bridge daemon              loop `tick` every MYTHOS_BRIDGE_INTERVAL_MS (120 s)
//   mythos-github-bridge status              local view of the control branch and executor state
//   mythos-github-bridge validate <file>     validate a task file offline (exit 1 when invalid)
//   mythos-github-bridge instruction <file>  print the instruction the executor would receive
//   mythos-github-bridge trail <task_id>     audit trail: Issue received → Action/Profile/Model resolved → created →
//                                            claimed → provider started/finished → report → GitHub updated
//   mythos-github-bridge runtime             which checkout/branch/HEAD this bridge binary actually runs from
//   mythos-github-bridge resolve <issue.json | N | ->   offline: the engine's Action/Model decision for an Issue payload
//   mythos-github-bridge notify-config       WhatsApp notification configuration + readiness (no secrets)
//   mythos-github-bridge notify-status       the notification ledger (states, attempts, errors)
//   mythos-github-bridge notify-flush        deliver due notifications now (retry path, safe to repeat)
//   mythos-github-bridge notify-breaker-reset  close the provider circuit after a gateway repair (sends nothing)
//   mythos-github-bridge notify-test --confirm   send ONE real smoke-test message (human-invoked only)
//
// GitHub Issues intake (bridge/github-issues.js; needs a token in the env, see docs/MYTHOS_GITHUB_ISSUES.md):
//   mythos-github-bridge issues-tick [--dry-run] [--only N[,M]] [--no-bridge]
//                                            intake (Issue → PENDING task) → bridge tick → notify (Issue comments)
//   mythos-github-bridge issues-status        Issue ⇄ task ⇄ executor ⇄ report relation from the control branch
//   mythos-github-bridge issues-parse <issue.json | N>
//                                            offline: what task an Issue payload (file, or number fetched read-only) would become
//   `tick` runs the issues phases too when MYTHOS_ISSUES_ENABLED=1 (the deploy timer drop-in sets it).
//
// Telegram channel (bridge/telegram.js; needs a bot token in the env, see docs/MYTHOS_TELEGRAM_CHANNEL.md):
//   mythos-github-bridge telegram-tick [--dry-run] [--no-bridge]
//                                            intake (private message → PENDING task) → bridge tick → notify (replies)
//   mythos-github-bridge telegram-status      update_id ⇄ task ⇄ executor ⇄ OTHMODE ⇄ report relation from the control branch
//   mythos-github-bridge telegram-config      channel configuration + readiness (no secrets)
//   mythos-github-bridge telegram-check       one read-only Bot API call (getMe) to prove the token works; prints the bot username only
//   mythos-github-bridge telegram-parse <update.json>
//                                            offline: what task a Telegram update payload would become
//   `tick` runs the Telegram intake BEFORE and the Telegram notify AFTER the bridge/Issues phases when
//   MYTHOS_TELEGRAM_ENABLED=1. WhatsApp notifications are unaffected: they are queued by the bridge tick and
//   flushed after it exactly as before.
//
// Unified Telegram lifecycle notifications (bridge/notify/telegram-notify.js; reuses the SAME bot as the
// Telegram channel above, see docs/MYTHOS_TELEGRAM_NOTIFICATIONS.md): a second sink alongside WhatsApp,
// queued by github-bridge.js (TASK completed/failed/blocked/human-approval) and github-issues.js (TASK
// created/started), delivered by `notify-telegram-flush` (also run automatically at the end of `tick`).
//   mythos-github-bridge notify-telegram-config   configuration + readiness (no secrets)
//   mythos-github-bridge notify-telegram-status   the notification ledger (states, attempts, errors)
//   mythos-github-bridge notify-telegram-flush    deliver due notifications now (retry path, safe to repeat)
//
// GitHub Pull Request notifications (bridge/github-prs.js; read-only, same token as the Issues adapter):
//   mythos-github-bridge pr-tick [--no-detail]   poll pulls → diff → enqueue Telegram notifications (opened/
//                                                updated/review/checks/merged/closed)
//   mythos-github-bridge pr-status               last-seen state per PR number
//   mythos-github-bridge pr-config                configuration + readiness (no secrets)
//   `tick` runs `pr-tick` after the bridge/Issues phase when MYTHOS_PR_NOTIFY_ENABLED=1. It never comments,
//   labels, merges or closes a PR — it only reads and notifies.
//
// Runs as the executor's user (deploy): it shares the executor store by
// requiring the executor module directly, exactly like bin/mythos-ai-executor
// enqueue does. No token, no network credential — Git over the deploy SSH
// identity is the only transport, and delivery is the root relay.
// =====================================================

var fs = require('fs');
var path = require('path');

var bridge = require('../bridge/github-bridge');

var argv = process.argv.slice(2);
var cmd = argv[0];
var arg = argv[1];

function out(v) { process.stdout.write(JSON.stringify(v, null, 2) + '\n'); }
function die(msg, code) { process.stderr.write(msg + '\n'); process.exit(code === undefined ? 1 : code); }

function executor() { return require('../executor'); }
function issues() { return require('../bridge/github-issues'); }
function telegram() { return require('../bridge/telegram'); }
function prs() { return require('../bridge/github-prs'); }
var TELEGRAM_ON = process.env.MYTHOS_TELEGRAM_ENABLED === '1';
var PR_NOTIFY_ON = process.env.MYTHOS_PR_NOTIFY_ENABLED === '1';
// Telegram phases around the existing tick. Both are no-ops (resolved, never
// rejected) when the channel is disabled, so the plain and Issues paths are
// byte-for-byte what they were.
function telegramBefore() { return TELEGRAM_ON ? telegram().intakeOnly({}) : Promise.resolve(null); }
function telegramAfter(r) {
  if (!TELEGRAM_ON) return Promise.resolve(r);
  return telegram().notifyOnly({}).then(function (n) { r.telegram_notify = n; return r; }, function (e) { r.telegram_notify = { ok: false, reason: String(e && e.message || e) }; return r; });
}
// PR polling is read-only and does not touch the control branch or the
// bridge lock, so it runs once after the bridge/Issues phase, before the
// notification flush — a failure here never changes this command's exit
// code, exactly like the WhatsApp/Telegram notification sinks.
function prsAfter(r) {
  if (!PR_NOTIFY_ON) return Promise.resolve(r);
  return prs().tick({}).then(function (p) { r.pr_notify = p; return r; }, function (e) { r.pr_notify = { ok: false, reason: String(e && e.message || e) }; return r; });
}
function fail(e) { die(String(e && e.message || e)); }
function onlyArg() {
  var i = argv.indexOf('--only');
  if (i !== -1 && argv[i + 1]) process.env.MYTHOS_ISSUES_ONLY = argv[i + 1];
  return process.env.MYTHOS_ISSUES_ONLY || '';
}

switch (cmd) {
  case 'init':
    out(bridge.init());
    break;
  case 'tick': {
    if (process.env.MYTHOS_ISSUES_ENABLED === '1') {
      // The Issues path runs the same bridge tick inside issuesTick(), so it
      // queues WhatsApp notifications exactly like the plain path does — and
      // it must therefore flush them exactly like the plain path does. It
      // did not, which made the whole notification layer inert in the only
      // configuration production actually runs (the deploy timer drop-in
      // sets MYTHOS_ISSUES_ENABLED=1): entries were written to the ledger by
      // every terminal task and nothing ever delivered them. Same ordering
      // guarantee as below — the flush happens strictly after the tick has
      // returned, and its outcome never changes this command's exit code.
      telegramBefore().then(function (ti) {
        return issues().issuesTick(executor(), { forceIndex: argv.indexOf('--index') !== -1, only: onlyArg() }).then(function (r) {
          if (ti) r.telegram_intake = ti;
          return telegramAfter(r);
        });
      }).then(prsAfter).then(function (r) {
        return bridge.flushNotifications().then(function (n) {
          r.notifications = n;
          out(r);
          process.exit(r.ok ? 0 : 2);
        });
      }, fail);
      break;
    }
    telegramBefore().then(function (ti) {
      var r = bridge.tick(executor(), { forceIndex: argv.indexOf('--index') !== -1 });
      if (ti) r.telegram_intake = ti;
      return telegramAfter(r);
    }).then(prsAfter).then(function (r) {
      // Notifications are delivered only after the tick has fully returned,
      // and their outcome never changes this command's exit code: a WhatsApp
      // failure is not a bridge failure.
      return bridge.flushNotifications().then(function (n) {
        r.notifications = n;
        out(r);
        process.exit(r.ok ? 0 : 2);
      });
    }, fail);
    break;
  }
  case 'issues-tick': {
    onlyArg();
    issues().issuesTick(executor(), { dryRun: argv.indexOf('--dry-run') !== -1, skipBridge: argv.indexOf('--no-bridge') !== -1, forceIndex: argv.indexOf('--index') !== -1 })
      .then(function (r) { out(r); process.exit(r.ok ? 0 : 2); }, fail);
    break;
  }
  case 'issues-status':
    out(issues().status());
    break;
  case 'telegram-tick': {
    telegram().telegramTick(executor(), { dryRun: argv.indexOf('--dry-run') !== -1, skipBridge: argv.indexOf('--no-bridge') !== -1, forceIndex: argv.indexOf('--index') !== -1 })
      .then(function (r) { out(r); process.exit(r.ok ? 0 : 2); }, fail);
    break;
  }
  case 'telegram-status':
    out(telegram().status());
    break;
  case 'telegram-config':
    out(telegram().describe());
    break;
  case 'telegram-check': {
    // Read-only proof that the configured token is accepted by the Bot API.
    // Prints the bot's public identity (id, username), never the token.
    var tmod = telegram();
    var tcfg = tmod.config();
    tmod.createClient(tcfg, tmod.readToken(), {}).getMe().then(function (me) {
      out({ ok: true, bot_id: me && me.id, username: me && me.username, can_read_all_group_messages: me && me.can_read_all_group_messages, api_base: tcfg.apiBase });
      process.exit(0);
    }, fail);
    break;
  }
  case 'telegram-parse': {
    if (!arg) die('usage: mythos-github-bridge telegram-parse <update.json>');
    var tm = telegram();
    var conv = tm.updateToTask(tm.config(), JSON.parse(fs.readFileSync(arg, 'utf8')));
    out({ valid: !!conv.task, malformed: !!conv.malformed, unauthorized: !!conv.unauthorized, secret: !!conv.secret, errors: conv.errors, message: conv.message || null, task: conv.task || conv.candidate || null });
    process.exit(conv.task ? 0 : 1);
    break;
  }
  case 'issues-parse': {
    if (!arg) die('usage: mythos-github-bridge issues-parse <issue.json | issue-number>');
    var mod = issues();
    var icfg = mod.config();
    var payload = /^\d+$/.test(arg) ? null : JSON.parse(fs.readFileSync(arg, 'utf8'));
    var p = payload ? Promise.resolve(payload) : mod.createClient(icfg, mod.readToken(), { dryRun: true }).getIssue(parseInt(arg, 10));
    p.then(function (issue) {
      var conv = mod.issueToTask(icfg, issue, 1);
      out({ issue: issue.number, title: issue.title, state: issue.state, labels: (issue.labels || []).map(function (l) { return l.name || l; }), valid: !!conv.task, errors: conv.errors, task: conv.task || conv.candidate });
      process.exit(conv.task ? 0 : 1);
    }, fail);
    break;
  }
  case 'pr-tick': {
    prs().tick({ skipDetail: argv.indexOf('--no-detail') !== -1 }).then(function (r) { out(r); process.exit(r.ok ? 0 : 2); }, fail);
    break;
  }
  case 'pr-status':
    out(prs().status());
    break;
  case 'pr-config':
    out(prs().config());
    break;
  case 'notify-telegram-config':
    out(bridge.telegramNotify.describe());
    break;
  case 'notify-telegram-status':
    out(bridge.telegramNotify.ledgerStatus());
    break;
  case 'notify-telegram-flush':
    bridge.telegramNotify.flush().then(function (n) { out(n); process.exit(n && n.ok === false ? 2 : 0); });
    break;
  case 'trail': {
    if (!arg) die('usage: mythos-github-bridge trail <task_id>');
    out(bridge.trail(arg));
    break;
  }
  case 'runtime': {
    var rcfg = bridge.config();
    var rid = bridge.runtimeIdentity(rcfg);
    rid.gate = bridge.runtimeGate(rid, rcfg);
    out(rid);
    break;
  }
  case 'resolve': {
    if (!arg) die('usage: mythos-github-bridge resolve <issue.json | issue-number | -> (stdin)');
    var eng = bridge.engine;
    var modelPolicy = require('../lib/model-policy');
    var src = arg === '-' ? Promise.resolve(JSON.parse(fs.readFileSync(0, 'utf8')))
      : (/^\d+$/.test(arg) ? issues().createClient(issues().config(), issues().readToken(), { dryRun: true }).getIssue(parseInt(arg, 10)) : Promise.resolve(JSON.parse(fs.readFileSync(arg, 'utf8'))));
    src.then(function (issue) {
      var body = typeof issue === 'string' ? issue : String(issue.body || '');
      var labels = typeof issue === 'string' ? [] : (issue.labels || []);
      var fields = eng.extractFields(body);
      var a = eng.resolveAction({ fields: fields, labels: labels });
      var m = eng.resolveModel({ fields: fields, labels: labels, policy: modelPolicy });
      out({ fields: fields, action: a, execution_profile: a.requested_action ? eng.profileFor(a.requested_action) : null, model: m });
      process.exit(a.error ? 1 : 0);
    }, fail);
    break;
  }
  case 'daemon':
    bridge.daemon(executor());
    break;
  case 'status':
    out(bridge.status());
    break;
  case 'validate': {
    if (!arg) die('usage: mythos-github-bridge validate <task.json>');
    var task;
    try { task = JSON.parse(fs.readFileSync(arg, 'utf8')); } catch (e) { die('invalid JSON: ' + e.message); }
    var errors = bridge.validateTask(bridge.config(), task, path.basename(arg));
    out({ valid: errors.length === 0, errors: errors, profile: errors.length ? null : bridge.PROFILE_BY_ACTION[task.requested_action] });
    process.exit(errors.length ? 1 : 0);
    break;
  }
  case 'instruction': {
    if (!arg) die('usage: mythos-github-bridge instruction <task.json>');
    var t = JSON.parse(fs.readFileSync(arg, 'utf8'));
    var cfg = bridge.config();
    process.stdout.write(bridge.buildInstruction(cfg, t, {
      othmode_task_id: 'OTH-XXXX-XXXXX', worktree: path.join(cfg.taskWorktrees, t.task_id),
      branch: 'mythos/gh/' + t.task_id, base_commit: '(origin/main at claim time)'
    }) + '\n');
    break;
  }
  case 'notify-config':
    out(bridge.whatsapp.describe());
    break;
  case 'notify-status':
    out(bridge.whatsapp.ledgerStatus());
    break;
  case 'notify-flush':
    bridge.flushNotifications().then(function (n) { out(n); process.exit(n && n.ok === false ? 2 : 0); });
    break;
  case 'notify-breaker-reset':
    // Closes the provider circuit after the gateway has been repaired,
    // instead of waiting out the cooldown. Sends nothing.
    out(bridge.whatsapp.resetBreaker());
    break;
  case 'notify-test': {
    // The single controlled real message of this stage. It is never invoked
    // by a tick, a timer or a test suite: only by a human, explicitly, and
    // only after the automated suites are green.
    if (argv.indexOf('--confirm') === -1) {
      die('notify-test sends a REAL WhatsApp message to every configured recipient.\n' +
        'Check `mythos-github-bridge notify-config` first, then re-run with --confirm.');
    }
    bridge.whatsapp.smokeTest().then(function (res) {
      out(res);
      process.exit(res.ok ? 0 : 2);
    });
    break;
  }
  default:
    die('usage: mythos-github-bridge <init|tick|daemon|status|validate <file>|instruction <file>|trail <task_id>|runtime|resolve <file|N|->|issues-tick|issues-status|issues-parse <file|N>|' +
      'telegram-tick|telegram-status|telegram-config|telegram-check|telegram-parse <file>|' +
      'notify-config|notify-status|notify-flush|notify-breaker-reset|notify-test --confirm|' +
      'notify-telegram-config|notify-telegram-status|notify-telegram-flush|' +
      'pr-tick [--no-detail]|pr-status|pr-config>');
}
