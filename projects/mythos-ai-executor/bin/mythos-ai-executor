#!/usr/bin/env node
'use strict';
// =====================================================
// Mythos AI Executor — CLI
// projects/mythos-ai-executor/bin/mythos-ai-executor
//
//   mythos-ai-executor enqueue <payload.json | '-'>   create + queue a task
//   mythos-ai-executor run <task-id>                  execute one task now
//   mythos-ai-executor resume <task-id>               resume a paused task
//   mythos-ai-executor status <task-id>               status + checkpoint
//   mythos-ai-executor report <task-id>               rendered report
//   mythos-ai-executor list [STATUS]                  queue summary
//   mythos-ai-executor health                         component health
//   mythos-ai-executor serve                          daemon + HTTP API (systemd entry)
//   mythos-ai-executor tick                           one scheduler step (debugging)
//
// Orchestration Core (Core Wiring stage; requires MYTHOS_CORE_ENABLED=true):
//   mythos-ai-executor goal submit <text> [--kind K] [--project P]
//   mythos-ai-executor goal run <goal-id>             advance to a terminal/waiting state
//   mythos-ai-executor goal status <goal-id>
//   mythos-ai-executor goal report <goal-id>
//   mythos-ai-executor goal cancel <goal-id>
//   mythos-ai-executor goal list
//
//   mythos-ai-executor dr-report                     AF: runtime-state gap report (read-only)
// =====================================================

var fs = require('fs');
var path = require('path');

var BASE = path.join(__dirname, '..');
var executor = require(path.join(BASE, 'executor'));
var state = require(path.join(BASE, 'lib', 'state'));

var cmd = process.argv[2];
var arg = process.argv[3];

function die(msg, code) {
  console.error(msg);
  process.exit(code === undefined ? 1 : code);
}

function printJSON(obj) { console.log(JSON.stringify(obj, null, 2)); }

switch (cmd) {
  case 'enqueue': {
    if (!arg) die('usage: mythos-ai-executor enqueue <payload.json | ->');
    var raw = arg === '-' ? fs.readFileSync(0, 'utf8') : fs.readFileSync(arg, 'utf8');
    try {
      var task = executor.createTask(JSON.parse(raw));
      printJSON({ task_id: task.task_id, status: 'QUEUED' });
    } catch (e) { die('ENQUEUE_REFUSED: ' + e.message, 2); }
    break;
  }
  case 'run':
  case 'resume': {
    if (!arg) die('usage: mythos-ai-executor ' + cmd + ' <task-id>');
    executor.runTask(arg).then(function (status) {
      printJSON(status);
      process.exit(['COMPLETED'].indexOf(status.status) !== -1 ? 0 : 3);
    }).catch(function (e) { die(cmd.toUpperCase() + '_ERROR: ' + e.message, 4); });
    break;
  }
  case 'status': {
    if (!arg) die('usage: mythos-ai-executor status <task-id>');
    var st = state.readStatus(arg);
    if (!st) die('no such task', 1);
    printJSON({ status: st, effective: state.effectiveStatus(st), checkpoint: state.readJSON(arg, 'checkpoint.json') });
    break;
  }
  case 'report': {
    if (!arg) die('usage: mythos-ai-executor report <task-id>');
    var md = state.readText(arg, 'report.md');
    if (!md) die('no report yet', 1);
    console.log(md);
    break;
  }
  case 'list': {
    var list = executor.summaries();
    if (arg) list = list.filter(function (s) { return s.status === arg; });
    printJSON(list);
    break;
  }
  case 'health': {
    executor.health().then(function (h) {
      printJSON(h);
      process.exit(h.ok ? 0 : 3);
    });
    break;
  }
  case 'serve': {
    require(path.join(BASE, 'server')).start();
    executor.daemon();
    break;
  }
  case 'tick': {
    executor.tick().then(printJSON).catch(function (e) { die('TICK_ERROR: ' + e.message, 4); });
    break;
  }
  case 'goal': {
    // Lazy-required so the Phase 1 CLI paths never load the core.
    var core = require(path.join(BASE, 'core', 'core-wiring'));
    var sub = process.argv[3];
    var rest = process.argv.slice(4);
    function flag(name, fallback) {
      var i = rest.indexOf('--' + name);
      return i !== -1 && rest[i + 1] ? rest[i + 1] : fallback;
    }
    if (!core.coreEnabled() && ['submit', 'run', 'cancel'].indexOf(sub) !== -1) {
      die('CORE_DISABLED: set MYTHOS_CORE_ENABLED=true to use the orchestration core (default off)', 5);
    }
    switch (sub) {
      case 'submit': {
        var text = rest.filter(function (a, i) {
          return a.indexOf('--') !== 0 && (i === 0 || rest[i - 1].indexOf('--') !== 0);
        }).join(' ').trim();
        if (!text) die('usage: mythos-ai-executor goal submit <text> [--kind K] [--project P]');
        try {
          printJSON(core.submitGoal({
            text: text,
            mission_kind: flag('kind', 'repo-analysis'),
            project: flag('project', 'mythos-prod'),
            requested_by: 'cli'
          }));
        } catch (e) { die('GOAL_REFUSED: ' + e.message, 2); }
        break;
      }
      case 'run': {
        if (!rest[0]) die('usage: mythos-ai-executor goal run <goal-id>');
        var st = core.goalStatus(rest[0]);
        if (!st) die('no such goal', 1);
        if (!st.missions.length) die('goal has no mission', 1);
        core.advanceMission(st.missions[0].id).then(function (mission) {
          printJSON({ mission_id: mission.id, status: mission.status,
            report_id: mission.metadata.report_id || null });
          process.exit(mission.status === 'COMPLETED' ? 0 : 3);
        }).catch(function (e) { die('RUN_ERROR: ' + e.message, 4); });
        break;
      }
      case 'status': {
        if (!rest[0]) die('usage: mythos-ai-executor goal status <goal-id>');
        var gs = core.goalStatus(rest[0]);
        if (!gs) die('no such goal', 1);
        printJSON(gs);
        break;
      }
      case 'report': {
        if (!rest[0]) die('usage: mythos-ai-executor goal report <goal-id>');
        var rs = core.goalStatus(rest[0]);
        if (!rs || !rs.missions.length) die('no such goal', 1);
        var rep = core.missionReport(rs.missions[0].id);
        if (!rep || !rep.report) die('no report yet', 1);
        printJSON(rep);
        break;
      }
      case 'cancel': {
        if (!rest[0]) die('usage: mythos-ai-executor goal cancel <goal-id>');
        var cs = core.goalStatus(rest[0]);
        if (!cs || !cs.missions.length) die('no such goal', 1);
        printJSON(core.cancelMission(cs.missions[0].id, 'cancelled via CLI'));
        break;
      }
      case 'list':
        printJSON({ core_enabled: core.coreEnabled(), goals: core.listGoals(25),
          mission_kinds: Object.keys(core.MISSION_KINDS) });
        break;
      default:
        die('usage: mythos-ai-executor goal <submit|run|status|report|cancel|list>', 1);
    }
    break;
  }
  case 'campaign': {
    var campaign = require(path.join(BASE, 'core', 'campaign'));
    var runner = require(path.join(BASE, 'core', 'campaign-runner'));
    var csub = process.argv[3];
    var crest = process.argv.slice(4);
    switch (csub) {
      case 'start': {
        var objective = crest.join(' ').trim();
        if (!objective) die('usage: mythos-ai-executor campaign start <objective>');
        try { printJSON(campaign.createCampaign({ objective: objective, requested_by: 'cli' })); }
        catch (e) { die('CAMPAIGN_REFUSED: ' + e.message, 2); }
        break;
      }
      case 'advance':
      case 'run': {
        if (!crest[0]) die('usage: mythos-ai-executor campaign ' + csub + ' <campaign-id>');
        var fn = csub === 'run' ? runner.runCampaign : runner.advanceCampaign;
        fn(crest[0], {}).then(function (out) { printJSON(out); process.exit(0); })
          .catch(function (e) { die('CAMPAIGN_ERROR: ' + e.message, 4); });
        break;
      }
      case 'resume': {
        if (!crest[0]) die('usage: mythos-ai-executor campaign resume <campaign-id>');
        runner.resumeCampaign(crest[0], {}).then(function (out) { printJSON(out); process.exit(0); })
          .catch(function (e) { die('CAMPAIGN_ERROR: ' + e.message, 4); });
        break;
      }
      case 'status': {
        if (!crest[0]) die('usage: mythos-ai-executor campaign status <campaign-id>');
        var cs = runner.campaignStatus(crest[0]);
        if (!cs) die('no such campaign', 1);
        printJSON(cs);
        break;
      }
      case 'roadmap': {
        var rm = require(path.join(BASE, 'core', 'roadmap'));
        var repo = crest[0] || require(path.join(BASE, 'core', 'core-wiring')).REPO_PATH;
        var sel = rm.selectNext(repo, {});
        printJSON({ next: sel.selected ? sel.selected.key + '. ' + sel.selected.title : null,
          reason: sel.reason, candidates: rm.candidates(repo).slice(0, 8).map(function (c) {
            return { key: c.key, title: c.title, status: c.effective_status,
              score: c.score, selectable: c.selectable, blocked: c.blocked_reasons }; }) });
        break;
      }
      case 'list':
        printJSON(campaign.listCampaigns().map(function (c) {
          return { campaign_id: c.campaign_id, state: c.state,
            objective: String(c.objective).slice(0, 90),
            completed: (c.completed_missions || []).length,
            blocked: (c.blocked_missions || []).length }; }));
        break;
      default:
        die('usage: mythos-ai-executor campaign <start|advance|run|resume|status|roadmap|list>', 1);
    }
    break;
  }
  case 'budget': {
    // READ-ONLY by design. There is deliberately no mutation verb:
    // limits are changed only by a reviewed commit to config/budgets.json.
    var budget = require(path.join(BASE, 'core', 'budget'));
    var bsub = process.argv[3];
    var bproj = process.argv[4] || 'mythos-prod';
    if (bsub === 'status') {
      printJSON(budget.status(bproj, {}));
    } else if (bsub === 'history') {
      printJSON({ project: bproj, entries: budget.history(bproj, {}) });
    } else if (bsub === 'reservations') {
      var all = budget.reservations(bproj, {});
      var byState = { ACTIVE: 0, EXPIRED: 0, RECOVERED: 0, SETTLED: 0, RELEASED: 0 };
      all.forEach(function (r) { byState[r.lease_state] = (byState[r.lease_state] || 0) + 1; });
      printJSON({ project: bproj, summary: byState, reservations: all });
    } else {
      die('usage: mythos-ai-executor budget <status|history|reservations> [project]  (read-only; limits change only in config/budgets.json)', 1);
    }
    break;
  }
  case 'dr-report': {
    // READ-ONLY by design — see core/dr-gap-report.js. Reports the runtime
    // queue/memory/state gap; never backs anything up or moves anything.
    var drReport = require(path.join(BASE, 'core', 'dr-gap-report'));
    printJSON(drReport.buildReport());
    break;
  }
  default:
    die('usage: mythos-ai-executor <enqueue|run|resume|status|report|list|health|serve|tick|goal|budget|campaign|dr-report>', 1);
}
