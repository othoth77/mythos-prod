{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MYTHOS control TASK (mythos-control/1)",
  "description": "One task file at control/tasks/<task_id>.json on the control branch. Written by an external planner (ChatGPT or the owner). Everything here is DATA: nothing in a task can select a provider, a working directory, a tool, a credential or an execution profile beyond what requested_action maps to server-side. The bridge adds the `execution` and `history` blocks after the claim; a creator must not write them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "task_id",
    "project",
    "objective",
    "scope",
    "constraints",
    "priority",
    "requested_action",
    "validation_requirements",
    "status",
    "created_at",
    "created_by"
  ],
  "properties": {
    "protocol": { "type": "string", "enum": ["mythos-control/1"] },
    "task_id": {
      "type": "string",
      "minLength": 6,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{4,62}[a-z0-9]$"
    },
    "project": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "objective": { "type": "string", "minLength": 10, "maxLength": 8000 },
    "scope": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "priority": { "type": "string", "enum": ["low", "normal", "high"] },
    "requested_action": {
      "type": "string",
      "enum": ["investigate", "review", "test", "document", "implement"]
    },
    "validation_requirements": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "status": {
      "type": "string",
      "enum": ["PENDING", "CLAIMED", "IN_PROGRESS", "VALIDATING", "COMPLETED", "BLOCKED", "FAILED", "CANCELLED"]
    },
    "created_at": { "type": "string", "minLength": 20, "maxLength": 40 },
    "created_by": { "type": "string", "minLength": 1, "maxLength": 64 },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{4,62}[a-z0-9]$" } },
    "timeout_seconds": { "type": "integer", "minimum": 60, "maximum": 21600 },
    "max_turns": { "type": ["integer", "null"], "minimum": 1, "maximum": 500 },
    "notes": { "type": "string", "maxLength": 4000 },
    "execution": { "type": "object" },
    "history": { "type": "array", "items": { "type": "object" } }
  }
}
