{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MYTHOS OS v4 executive directive",
  "description": "The ONE shape an executive (FABLE 5.1, or OpenAI during a takeover) may answer with. It is data: DOTS authorises every field against its policy before anything runs. Only keywords both validators understand are used (mythos-orchestrator/lib/schema.js and OpenAI strict structured output); lengths and counts are enforced by DOTS, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "rationale", "steps", "final_answer", "escalation_reason"],
  "properties": {
    "decision": { "type": "string", "enum": ["execute", "complete", "escalate"] },
    "rationale": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "action", "instruction", "acceptance", "timeout_seconds"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["answer", "work"] },
          "action": { "type": "string", "enum": ["analyze", "research", "review", "plan", "summarize", "investigate", "test", "document", "implement"] },
          "instruction": { "type": "string" },
          "acceptance": { "type": "array", "items": { "type": "string" } },
          "timeout_seconds": { "type": "integer" }
        }
      }
    },
    "final_answer": { "type": ["string", "null"] },
    "escalation_reason": { "type": ["string", "null"] }
  }
}
