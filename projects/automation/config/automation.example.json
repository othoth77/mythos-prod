{
  "_note": "Mythos Automation & Operations configuration draft — Stage AUT-0. All feature flags and live-connector flags are false EXCEPT those ratified by owner decision O-BACKUP-6 (2026-08-16): backup_storage_readonly is enabled (READ_ONLY, capabilities unchanged, credential by reference secref-r2-backup only), and level_2_recommend_runs / level_4_full_automatic_runs are true for the INF-BACKUP-AUTO-0 operations they gate. level_3_approval_required_runs remains false. No real credentials, tokens, account IDs, emails, IPs, or production data. Not deployed.",
  "version": "0.1.0-aut0-draft",
  "product": {
    "product_key": "mythos_automation",
    "capability_name": "Mythos Automation & Operations",
    "operator_product": "Mythos Control Center",
    "group_principle": "Automation First",
    "group_principle_statement": "Every safe, repeatable and measurable operation should eventually be automated. Automation must not remove governance. High-risk actions remain automated in preparation and validation, but require explicit human approval before execution.",
    "stage": "AUT-0",
    "ecosystem": "mythos"
  },
  "database": {
    "_note": "Target DBMS selected. NOT INSTALLED OR DEPLOYED in AUT-0.",
    "target_dbms": "PostgreSQL",
    "logical_schema": "mythos_automation",
    "implementation_stage": "INF-OVH-API-0 or later"
  },
  "automation_levels": [
    {
      "level": "LEVEL_1_READ_ONLY",
      "description": "Discover, inspect, export, snapshot, compare, report. No external mutation.",
      "may_self_promote": false
    },
    {
      "level": "LEVEL_2_RECOMMEND",
      "description": "Analyse, create plans, simulate, dry-run, calculate impact, generate rollback plans. No external mutation.",
      "may_self_promote": false
    },
    {
      "level": "LEVEL_3_APPROVAL_REQUIRED",
      "description": "Prepare the action automatically, verify all gates automatically, require explicit authorised approval, execute only after approval, verify automatically, rollback automatically when the approved policy permits.",
      "may_self_promote": false
    },
    {
      "level": "LEVEL_4_FULL_AUTOMATIC",
      "description": "Execute without per-run human approval. Permitted only for approved low-risk operations. Must have monitoring, audit, bounded retries and rollback or safe failure. Requires a previously approved policy.",
      "may_self_promote": false
    }
  ],
  "run_statuses": {
    "non_terminal": [
      "QUEUED",
      "DISCOVERING",
      "SNAPSHOTTING",
      "ANALYSING",
      "PLANNED",
      "DRY_RUN_COMPLETE",
      "BLOCKED",
      "AWAITING_APPROVAL",
      "APPROVED",
      "APPLYING",
      "VERIFYING",
      "ROLLING_BACK"
    ],
    "terminal": [
      "REJECTED",
      "SUCCEEDED",
      "FAILED",
      "ROLLED_BACK",
      "MANUAL_INTERVENTION_REQUIRED",
      "CANCELLED"
    ]
  },
  "lifecycle": [
    "DISCOVER",
    "SNAPSHOT",
    "ANALYSE",
    "PLAN",
    "DRY_RUN",
    "GATE_CHECK",
    "APPROVAL",
    "APPLY",
    "VERIFY",
    "ROLLBACK",
    "AUDIT",
    "NOTIFY",
    "CLOSE"
  ],
  "trigger_types": [
    "MANUAL",
    "SCHEDULED",
    "EVENT",
    "API"
  ],
  "failure_classes": [
    "TRANSIENT",
    "RATE_LIMITED",
    "AUTHENTICATION",
    "AUTHORIZATION",
    "VALIDATION",
    "CONFLICT",
    "EXTERNAL_PROVIDER",
    "TIMEOUT",
    "SECURITY",
    "DATA_INTEGRITY",
    "MANUAL_INTERVENTION"
  ],
  "approval_rules": {
    "self_approval_allowed": false,
    "separation_of_duties_required_for": [
      "domain_nameserver_changes",
      "dnssec_or_ds_record_changes",
      "production_dns_record_deletion",
      "production_database_destructive_migration",
      "production_database_deletion",
      "production_data_overwrite",
      "deletion_of_backups",
      "disabling_backups",
      "secret_or_credential_exposure",
      "privilege_escalation",
      "changing_super_admin_access",
      "production_firewall_or_network_access_changes",
      "sending_or_transferring_money",
      "issuing_refunds",
      "contractual_acceptance",
      "public_publication_of_sensitive_or_regulated_data",
      "production_shutdown",
      "irreversible_external_provider_actions"
    ],
    "expired_approval_reusable": false,
    "rejected_run_can_execute": false,
    "rollback_is_separate_audited_execution": true
  },
  "retry_defaults": {
    "strategy": "exponential_backoff",
    "initial_delay_seconds": 5,
    "max_delay_seconds": 300,
    "max_retries": 5,
    "mutating_retries_require_idempotency": true,
    "retryable_failure_classes": [
      "TRANSIENT",
      "RATE_LIMITED",
      "TIMEOUT",
      "EXTERNAL_PROVIDER"
    ],
    "non_retryable_failure_classes": [
      "SECURITY",
      "DATA_INTEGRITY",
      "AUTHENTICATION",
      "AUTHORIZATION",
      "VALIDATION",
      "MANUAL_INTERVENTION"
    ],
    "dead_letter_after_retry_exhaustion": true
  },
  "timeout_defaults": {
    "level_1_read_only_seconds": 60,
    "level_2_recommend_seconds": 120,
    "level_3_approval_required_seconds": 300,
    "level_4_full_automatic_seconds": 120,
    "approval_wait_timeout_seconds": 86400
  },
  "notification_priorities": [
    "INFO",
    "WARNING",
    "HIGH",
    "CRITICAL"
  ],
  "notification_rules": {
    "successful_routine_operations": "may_be_summarised",
    "failures_requiring_action": "notify_immediately",
    "repeated_identical_alerts": "must_be_deduplicated",
    "alerts_must_link_to": [
      "run_id",
      "incident_id"
    ],
    "redact_secrets_and_personal_data": true
  },
