# MYTHOS WP — user-level systemd unit (deploy user manager, linger enabled)
#
# Install (as deploy):
#   install -m 0644 projects/mythos-wp/deploy/mythos-wp.user.service ~/.config/systemd/user/mythos-wp.service
#   systemctl --user daemon-reload && systemctl --user enable --now mythos-wp
#
# Same shape and the same hardening set as the sibling units that run green on
# this host (mythos-command-center, ssangyong-storefront): user scope because
# `deploy` cannot write /etc/systemd/system; no ProtectKernelTunables /
# ProtectClock / RestrictNamespaces (capability drop refused in user scope →
# status=218); no MemoryDenyWriteExecute (V8 JIT). See those units' headers.
#
# WorkingDirectory/ExecStart point at the implementation worktree of branch
# mythos/wp-20260905 until the branch is merged; then switch both to the main
# checkout (/home/deploy/projects/mythos-prod) and restart.
#
# The process binds 127.0.0.1:8170 only; nginx (wp.mythosprod.xyz) is the
# only public surface.

[Unit]
Description=MYTHOS WP — MYTHOS Web Panel (catalogue / prices / stock / Auto-Reply data layer) for wp.mythosprod.xyz
Documentation=https://github.com/othoth77/mythos-prod
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/deploy/worktrees/mythos-wp-main/projects/mythos-wp

# Credentials live outside the git worktree, mode 0600, never echoed:
# MYTHOS_WP_DB_*, MYTHOS_WP_USERS_FILE, MYTHOS_WP_CATALOG_* (URL per project),
# optional MYTHOS_WP_COMMS_CONFIG. server.js refuses to start without the DB set.
EnvironmentFile=/home/deploy/deployments/mythos-wp/.env

ExecStart=/usr/bin/node /home/deploy/worktrees/mythos-wp-main/projects/mythos-wp/reference/server.js

Restart=on-failure
RestartSec=5s

# Resource ceiling: the host has ~2.8 GiB available and an OOM history. The
# panel idles near 90 MiB; 256 MiB is a generous cap that still protects the
# production services from a runaway.
MemoryMax=256M
MemoryHigh=200M

# --- Hardening (the set that runs green in user scope on this host) --------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The panel writes only to PostgreSQL. Nothing on the filesystem is writable.
ReadWritePaths=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mythos-wp

[Install]
WantedBy=default.target
