# Facebook Ads Monitor — daily READ-ONLY report (install: see ../README.md)
# Facebook Ads Monitor is READ-ONLY by design: Graph API GET only, allowlisted read endpoints.
[Unit]
Description=MYTHOS Facebook Ads daily monitor (READ-ONLY by design)
Documentation=file:/home/deploy/projects/mythos-prod/projects/meta-ads-monitor/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/projects/mythos-prod
ExecStart=/usr/bin/env node projects/meta-ads-monitor/bin/meta-ads-monitor.js run
# 75 = another run holds the lock (duplicate-run protection), not a failure
SuccessExitStatus=75
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
MemoryMax=256M
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadOnlyPaths=/home/deploy
ReadWritePaths=/home/deploy/.local/state/meta-ads-monitor
