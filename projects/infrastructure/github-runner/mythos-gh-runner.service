# =====================================================
# Mythos OS — GitHub Actions self-hosted runner (hardened unit)
# Installed by provision-runner.sh to:
#   /etc/systemd/system/mythos-gh-runner.service
#
# Identity model (load-bearing — see docs/VPS_RUNNER_PROVISIONING.md):
#   - Runs as the dedicated least-privilege account `mythos-runner`.
#   - NO docker group, NO mythos-gov group, NO sudoers entry.
#   - NoNewPrivileges=yes means sudo/setuid can NEVER work from a job,
#     so the runner is structurally unable to escalate — the section-4
#     "runner sudo boundary" of the VPS Final Gate order is satisfied by
#     granting nothing at all. If a future gate step genuinely requires
#     root, that is a conscious operator decision documented in the
#     runbook §8, never a default.
#   - ProtectHome=read-only: jobs read nothing writable under /home
#     (deploy's checkout stays intact); the runner's own home is /opt.
#     /etc and /var are left under real DAC so governance EACCES probes
#     measure the true file modes, not sandbox artifacts.
# =====================================================
[Unit]
Description=Mythos GitHub Actions self-hosted runner (othoth77/mythos-prod)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mythos-runner
Group=mythos-runner
WorkingDirectory=/opt/mythos-gh-runner
ExecStart=/opt/mythos-gh-runner/run.sh
Restart=always
RestartSec=15
KillMode=process
KillSignal=SIGINT
TimeoutStopSec=5min

# --- privilege boundary ---
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=no
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/opt/mythos-gh-runner
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
