{
  "product_key": "mythos_research",
  "product_name": "Mythos Research Intelligence",
  "version": "0.1.0-res0-draft",
  "description": "Free-first, provider-independent external research capability for the Mythos platform",
  "enabled": false,
  "runtime_implemented": false,
  "deployment_status": "NOT_DEPLOYED",
  "stage": "RES-0",
  "stage_status": "DOCUMENTATION_ONLY",

  "default_mode": "FREE_PREFERRED",
  "available_modes": ["FREE_ONLY", "FREE_PREFERRED", "BALANCED", "PREMIUM_ALLOWED"],

  "research_gateway": {
    "implemented": false,
    "max_results_default": 10,
    "max_results_limit": 50,
    "request_timeout_ms": 30000,
    "max_redirects": 5
  },

  "source_strategy": {
    "implemented": false,
    "provider_order": ["internal", "official", "searxng", "brave", "tavily", "perplexity"],
    "fallback_enabled": true,
    "max_fallback_depth": 3
  },

  "providers": {
    "official_source": {
      "enabled": false,
      "implemented": false,
      "allowed_domains": [],
      "max_response_size_bytes": 10485760,
      "timeout_ms": 15000
    },
    "searxng": {
      "enabled": false,
      "implemented": false,
      "deployed": false,
      "base_url": "",
      "timeout_ms": 20000,
      "engines": [],
      "private_access_only": true
    },
    "brave": {
      "enabled": false,
      "implemented": false,
      "api_key_env": "MYTHOS_RESEARCH_BRAVE_API_KEY",
      "base_url": "https://api.search.brave.com/res/v1/web/search",
      "timeout_ms": 15000
    },
    "tavily": {
      "enabled": false,
      "implemented": false,
      "api_key_env": "MYTHOS_RESEARCH_TAVILY_API_KEY",
      "base_url": "https://api.tavily.com/search",
      "timeout_ms": 20000
    },
    "perplexity": {
      "enabled": false,
      "implemented": false,
      "api_key_env": "MYTHOS_RESEARCH_PERPLEXITY_API_KEY",
      "base_url": "https://api.perplexity.ai/chat/completions",
      "timeout_ms": 45000,
      "model": "sonar-pro"
    }
  },

  "security": {
    "minimal_context": true,
    "redaction_required": true,
    "ssrf_protection_required": true,
    "private_network_access": false,
    "allowed_schemes": ["https"],
    "conditionally_allowed_schemes": ["http"],
    "blocked_schemes": ["file", "ftp", "gopher", "data", "javascript", "dict"],
    "redirect_limit": 5,
    "redirect_host_revalidation": true,
    "dns_rebinding_protection": true,
    "content_type_whitelist": ["text/html", "application/json", "text/plain", "application/xml", "text/xml"],
    "max_response_size_bytes": 10485760,
    "safe_user_agent": "MythosResearchIntelligence/1.0"
  },

  "cache": {
    "enabled": false,
    "implemented": false,
    "default_ttl_seconds": {
      "STATIC": 2592000,
      "LONG": 86400,
      "MEDIUM": 3600,
      "SHORT": 900,
      "NO_CACHE": 0
    },
    "max_cache_entries": 10000,
    "private_research_default_no_cache": true
  },

  "source_trust": {
    "implemented": false,
    "authoritative_domains": [],
    "high_trust_domains": [],
    "blocked_domains": [],
    "minimum_trust_score": 0.0
  },

  "freshness": {
    "implemented": false,
    "default_required_freshness": "CURRENT",
    "available_freshness_classes": ["STATIC", "SLOW_CHANGING", "CURRENT", "HIGH_FRESHNESS"]
  },

  "citation": {
    "implemented": false,
    "deduplication_enabled": true,
    "max_citations_per_result": 20
  },

  "budget": {
    "implemented": false,
    "mode": "FREE_PREFERRED",
    "per_session_cost_limit": null,
    "per_period_cost_limit": null,
    "cost_tracking_enabled": false
  },

  "audit": {
    "enabled": false,
    "implemented": false,
    "log_query_hashes_only": true,
    "retention_days": 90
  },

  "integration": {
    "personal_intelligence": {
      "status": "PENDING_MPI_MERGE",
      "capability_contract": "research.web",
      "available_capabilities": ["research.web", "research.official", "research.deep", "research.market", "research.technical"]
    },
    "automation": {
      "status": "FUTURE",
      "health_check_capability": "NOT_IMPLEMENTED"
    }
  },

  "feature_flags": {
    "research_gateway": false,
    "official_source_fetcher": false,
    "searxng_adapter": false,
    "brave_adapter": false,
    "tavily_adapter": false,
    "perplexity_adapter": false,
    "source_trust_scorer": false,
    "freshness_evaluator": false,
    "citation_normalizer": false,
    "research_cache": false,
    "redaction_guard": false,
    "research_audit": false,
    "budget_guard": false,
    "deep_research": false
  }
}