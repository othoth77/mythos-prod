# ContextForge (IBM mcp-context-forge) — configuration TEMPLATE.
#
# The real file is /home/deploy/deployments/mythos-gateway/contextforge.env
# (0600, deploy-owned, outside the worktree). It holds the same variables with
# real values. Nothing with a value is committed: every secret below is a
# placeholder, and tests/gateway-boundary-test.js §5 fails if that stops
# being true.
#
# Generate the four secrets with `openssl rand -hex 48` / `-base64 24`.

ENVIRONMENT=production
HOST=0.0.0.0
PORT=4444
APP_DOMAIN=https://mythosprod.xyz

# The gateway is mounted on a path, not a subdomain: mythosprod.xyz is served
# by OVH DNS and no API credential for it exists on this host, so a new record
# is an owner action. APP_ROOT_PATH tells the gateway to build its own URLs
# behind that prefix.
APP_ROOT_PATH=/gateway

# SQLite is deliberate: one file to back up, one file to delete on rollback,
# and no fourth database engine on a host that already runs three. Migrations
# must be run ONCE, single-process, before any worker starts — the default
# nine workers race their own migration and leave the schema half-applied.
DATABASE_URL=sqlite:////app/data/mcp.db

JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_48
AUTH_ENCRYPTION_SECRET=CHANGE_ME_openssl_rand_hex_48

# Authentication is mandatory on every path.
AUTH_REQUIRED=true
MCP_CLIENT_AUTH_ENABLED=true
EMAIL_AUTH_ENABLED=true
REQUIRE_TOKEN_EXPIRATION=true

# The admin UI and the admin API stay OFF. Peers, virtual servers and client
# credentials are managed through the authenticated REST API from the host,
# never from a browser on the public internet. nginx blocks the admin path a
# second time, so this setting is not the only lock.
MCPGATEWAY_UI_ENABLED=false
MCPGATEWAY_ADMIN_API_ENABLED=false
API_ALLOW_BASIC_AUTH=false
DOCS_ALLOW_BASIC_AUTH=false

BASIC_AUTH_USER=mythos-gateway-admin
BASIC_AUTH_PASSWORD=CHANGE_ME_openssl_rand_base64_24
PLATFORM_ADMIN_EMAIL=CHANGE_ME_owner_email
PLATFORM_ADMIN_FULL_NAME=MYTHOS Owner
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_openssl_rand_base64_24

CORS_ENABLED=true
ALLOWED_ORIGINS=["https://mythosprod.xyz"]
SECURITY_HEADERS_ENABLED=true
SKIP_SSL_VERIFY=false
DEBUG=false
DEV_MODE=false
LOG_LEVEL=INFO

# Two workers, not the auto-detected nine. Memory is the scarce resource on
# this host and the gateway must never be the reason a production service is
# reclaimed. Two keeps a worker available while one is busy on an upstream.
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# SSRF protection stays ON and private networks stay blocked. Exactly one /24
# is allowed: the gateway's own docker network, which holds the MYTHOS MCP
# transport (10.0.60.1, the host side) and the GitHub MCP container. Nothing
# else on this host — not the databases, not the other containers, not the
# cloud metadata endpoint — is reachable from a URL registered in the gateway.
SSRF_PROTECTION_ENABLED=true
SSRF_ALLOW_PRIVATE_NETWORKS=false
SSRF_ALLOWED_NETWORKS=["10.0.60.0/24"]
SSRF_ALLOW_LOCALHOST=false
