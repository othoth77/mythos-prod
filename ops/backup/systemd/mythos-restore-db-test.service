[Unit]
Description=Mythos monthly restore test — database-only, mythos_erp, isolated throwaway destination
Documentation=file:/home/deploy/projects/mythos-prod/ops/backup/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/projects/mythos-prod
ExecStart=/usr/bin/env bash /home/deploy/projects/mythos-prod/ops/backup/mythos-backup-run-db.sh restore-test
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
