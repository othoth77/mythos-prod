[Unit]
Description=Mythos database dump (in-container pg_dump/mysqldump, feeds the off-host backup)
Documentation=file:/home/deploy/projects/mythos-prod/ops/backup/README.md
Documentation=file:/home/deploy/projects/mythos-prod/docs/OFF_HOST_BACKUP_GATE.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Runs as root ONLY because docker exec is required and deploy is
# deliberately not in the docker group. Confining the docker-touching step to
# this one unit is what keeps mythos-backup.service at User=deploy.
User=root
Group=root
WorkingDirectory=/home/deploy/projects/mythos-prod
ExecStart=/usr/bin/env bash /home/deploy/projects/mythos-prod/ops/backup/mythos-db-dump.sh
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
ProtectHome=no
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
