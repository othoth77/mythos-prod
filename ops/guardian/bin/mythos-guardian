#!/usr/bin/env node
'use strict';
// =====================================================
// MYTHOS Guardian V0 — CLI
// ops/guardian/bin/mythos-guardian
//
//   mythos-guardian run [--dry-run] [--json]     one observe tick
//   mythos-guardian status [--json]              last report, reads only
//   mythos-guardian simulate <scenario|all>      dry-run, synthetic host
//   mythos-guardian scenarios                    list scenarios
//   mythos-guardian validate [--config PATH]     check configuration
//   mythos-guardian incident [--json]            last report, OTH format
//   mythos-guardian selftest                     prove the observe-only
//                                                boundary on this host
//
// EVERY subcommand is read-only with respect to the host. The only writes
// this program can perform are inside its own state directory, and the I/O
// layer refuses anything else (io.assertOwnState).
//
// `simulate` is ALWAYS dry-run: it cannot be made to execute a live tick.
// =====================================================

var path = require('path');
var os = require('os');
var lib = path.join(__dirname, '..', 'lib');
var ioMod = require(path.join(lib, 'io'));
var configMod = require(path.join(lib, 'config'));
var engine = require(path.join(lib, 'engine'));
var report = require(path.join(lib, 'report'));
var scenarios = require(path.join(lib, 'scenarios'));
var sources = require(path.join(lib, 'sources'));
var actionsMod = require(path.join(lib, 'actions'));
var remediateMod = require(path.join(lib, 'remediate'));
var levels = require(path.join(lib, 'levels'));

var VERSION = '1.0.0';

function defaultStateDir() {
  return process.env.MYTHOS_GUARDIAN_STATE_DIR || path.join(os.homedir(), '.local', 'state', 'mythos-guardian');
}
function defaultConfigPath() {
  return process.env.MYTHOS_GUARDIAN_CONFIG || path.join(os.homedir(), '.config', 'mythos', 'guardian.json');
}

function parseArgs(argv) {
  var out = { _: [], flags: {} };
  for (var i = 0; i < argv.length; i++) {
    var a = argv[i];
    if (a.indexOf('--') === 0) {
      var eq = a.indexOf('=');
      if (eq > 0) out.flags[a.slice(2, eq)] = a.slice(eq + 1);
      else if (argv[i + 1] && argv[i + 1].indexOf('--') !== 0 && ['config', 'state-dir', 'ticks'].indexOf(a.slice(2)) >= 0) out.flags[a.slice(2)] = argv[++i];
      else out.flags[a.slice(2)] = true;
    } else out._.push(a);
  }
  return out;
}

function usage() {
  return [
    'mythos-guardian ' + VERSION + ' — MYTHOS Guardian (observe-only)',
    '',
    '  run [--dry-run] [--json]        one observe tick (writes only Guardian state)',
    '  remediate [--execute] [--json]  show what remediation would do; --execute performs it',
    '  actions [--json]                list every action Guardian can ever take',
    '  audit [--lines N] [--json]      the record of actions actually taken',
    '  status [--json]                 show the last report (reads only)',
    '  incident [--json]               render the last report in the OTH incident format',
    '  simulate <name|all> [--ticks N] dry-run against a synthetic host (never touches this one)',
    '  scenarios                       list the simulation scenarios',
    '  validate [--config PATH]        validate configuration and print the effective policy',
    '  selftest                        prove the observe-only boundary on this host',
    '',
    'Options: --state-dir PATH  --config PATH  --json',
    '',
    'Remediation is OFF by default (observe_only). It has no kill and no delete:',
    'every action is a static entry in ops/guardian/lib/actions.js, individually gated.'
  ].join('\n');
}

function main(argv) {
  var args = parseArgs(argv);
  var cmd = args._[0] || 'status';
  var stateDir = args.flags['state-dir'] || defaultStateDir();
  var configPath = args.flags.config || defaultConfigPath();
  var json = !!args.flags.json;
  var io = ioMod.createIo({});

  if (cmd === 'help' || args.flags.help) { console.log(usage()); return 0; }
  if (cmd === 'version') { console.log(VERSION); return 0; }

  if (cmd === 'scenarios') {
    var names = scenarios.names();
    if (json) { console.log(JSON.stringify(names.map(function (n) { return { name: n, why: scenarios.SCENARIOS[n].why, expect: scenarios.SCENARIOS[n].expect }; }), null, 2)); return 0; }
    console.log('Scenarios (' + names.length + '), all dry-run against synthetic data:\n');
    names.forEach(function (n) { console.log('  ' + n + (' '.repeat(Math.max(1, 34 - n.length))) + scenarios.SCENARIOS[n].why); });
    return 0;
  }

  if (cmd === 'validate') {
    var loaded = configMod.load(io, configPath);
    var errs = configMod.validate(loaded.config);
    var out = {
      config_path: configPath, config_present: io.exists(configPath), source: loaded.source,
      load_errors: loaded.errors, validation_errors: errs,
      observe_only: loaded.config.observe_only,
      remediation: engine.remediationPosture(loaded.config),
      state_dir: stateDir,
      domains: engine.DOMAINS,
      units: loaded.config.services.units.length, containers: loaded.config.services.containers.length,
      backup_records: loaded.config.backup.records.length
    };
    if (json) { console.log(JSON.stringify(out, null, 2)); return errs.length ? 1 : 0; }
    console.log('config     ' + configPath + (out.config_present ? '' : ' (absent — built-in defaults)'));
    console.log('effective  ' + loaded.source);
    console.log('state dir  ' + stateDir);
    console.log('observing  ' + engine.DOMAINS.join(', '));
    console.log('watching   ' + out.units + ' units, ' + out.containers + ' containers, ' + out.backup_records + ' backup records');
    console.log('posture    observe-only=' + out.remediation.observe_only + ', remediation available=' + out.remediation.remediation_available);
    if (loaded.errors.length) loaded.errors.forEach(function (e) { console.log('IGNORED    ' + e); });
    if (errs.length) { errs.forEach(function (e) { console.log('INVALID    ' + e); }); return 1; }
    console.log('OK');
    return 0;
  }

  if (cmd === 'run') {
    var dry = !!args.flags['dry-run'];
    var runCfg = configMod.load(io, configPath).config;
    var res = engine.run({
      io: io, state_dir: stateDir, config_path: configPath, dry_run: dry,
      measure: sources.measure(runCfg.disk, io),
      // The scheduled tick acts only when remediation.on_schedule is true.
      // Default false: remediation exists but waits to be asked. Enabling it
      // is a separate decision from enabling any individual flag, so
      // "Guardian may clear a cache" and "Guardian may do so unattended"
      // are never the same checkbox.
      execute_actions: runCfg.observe_only === false && runCfg.remediation.on_schedule === true,
      guardian_version: VERSION
    });
    if (res.skipped) {
      if (json) { console.log(JSON.stringify(res, null, 2)); return 0; }
      console.log('skipped: another Guardian tick holds the lock' + (res.held_by ? ' (pid ' + res.held_by.pid + ' since ' + res.held_by.at + ')' : ''));
      return 0;   // not an error: the timer simply overlapped
    }
    if (json) { console.log(JSON.stringify(res.report, null, 2)); return 0; }
    console.log(report.text(res.report));
    if (!dry) console.log('\nwrote: ' + Object.keys(res.written).filter(function (k) { return res.written[k]; }).join(', ') + '  (Guardian state only)');
    else console.log('\ndry run: nothing was written');
    return 0;
  }

  if (cmd === 'status' || cmd === 'incident') {
    var rp = engine.paths(stateDir).report;
    var last = io.readJson(rp);
    if (!last) {
      var msg = { state: 'NOT_RUN', state_dir: stateDir, report: rp, note: 'Guardian has not produced a report yet' };
      if (json) console.log(JSON.stringify(msg, null, 2));
      else console.log('MYTHOS Guardian — NOT_RUN (no report at ' + rp + ')');
      return 0;
    }
    if (json) { console.log(JSON.stringify(last, null, 2)); return 0; }
    console.log(cmd === 'incident' ? report.incident(last) : report.text(last));
    return 0;
  }

  if (cmd === 'simulate') {
    var name = args._[1];
    if (!name) { console.error('simulate: name required (see `mythos-guardian scenarios`)'); return 2; }
    var cfg = configMod.load(io, configPath).config;
    var list = name === 'all' ? scenarios.names() : [name];
    if (name !== 'all' && !scenarios.SCENARIOS[name]) { console.error('simulate: unknown scenario ' + name); return 2; }
    var ticks = parseInt(args.flags.ticks || '3', 10);
    var results = list.map(function (n) { return simulateOne(io, cfg, n, ticks); });
    if (json) { console.log(JSON.stringify(results, null, 2)); return 0; }
    var bad = 0;
    results.forEach(function (r) {
      var ok = r.matches_expectation !== false;
      if (!ok) bad++;
      console.log((ok ? 'PASS  ' : 'DIFF  ') + r.scenario + (' '.repeat(Math.max(1, 34 - r.scenario.length))) +
        'host=' + r.final.host + (r.final.partial ? '(partial)' : '') + '  guardian=' + r.final.guardian +
        '  [' + engine.DOMAINS.map(function (d) { return d[0] + ':' + r.final.domains[d]; }).join(' ') + ']');
      if (!ok) console.log('      expected ' + JSON.stringify(r.expect) + ', findings: ' + r.findings.join('; '));
    });
    console.log('\n' + results.length + ' scenario(s), ' + (results.length - bad) + ' matched expectation, ' + bad + ' differed. Nothing was written; the real host was never read.');
    return bad ? 1 : 0;
  }

  if (cmd === 'actions') {
    var all = actionsMod.list();
    if (json) { console.log(JSON.stringify(all.map(function (a) {
      return { id: a.id, domain: a.domain, flag: a.flag, min_level: a.min_level, cooldown_s: a.cooldown_s,
        max_per_day: a.max_per_day, reversible: a.reversible, protects: a.protects, title: a.title, description: a.description };
    }), null, 2)); return 0; }
    console.log('Every action MYTHOS Guardian can take. There are no others: an id not in\n' +
                'ops/guardian/lib/actions.js does not exist, and nothing can add one at runtime.\n');
    all.forEach(function (a) {
      console.log('  ' + a.id);
      console.log('    ' + a.title);
      console.log('    domain ' + a.domain + '  needs ' + a.flag + '  at ' + a.min_level + '+  cooldown ' + Math.round(a.cooldown_s / 60) + ' min  max ' + a.max_per_day + '/day');
      console.log('    reversible: ' + a.reversible);
      a.protects.forEach(function (x) { console.log('    protects:   ' + x); });
      console.log('');
    });
    console.log('Never, at any level, under any configuration: no kill, no delete, no database,');
    console.log('no backup, no credential, no production volume, no critical or production unit.');
    return 0;
  }

  if (cmd === 'audit') {
    var af = engine.paths(stateDir).actions;
    var text = io.readFile(af);
    if (!text) { console.log(json ? '[]' : 'No action has ever been taken (no record at ' + af + ').'); return 0; }
    var lines = text.trim().split('\n').filter(Boolean);
    var n = parseInt(args.flags.lines || '20', 10);
    var recs = lines.slice(-n).map(function (l) { try { return JSON.parse(l); } catch (e) { return null; } }).filter(Boolean);
    if (json) { console.log(JSON.stringify(recs, null, 2)); return 0; }
    console.log('MYTHOS Guardian — actions taken (' + lines.length + ' total, showing ' + recs.length + ')\n');
    recs.forEach(function (r) {
      console.log('  ' + r.at + '  ' + r.action + (r.target ? ' [' + r.target + ']' : ''));
      console.log('    mode ' + r.mode + '  result ' + r.result + (r.verified === null ? '' : '  verified ' + r.verified));
      if (r.argv) console.log('    ran  ' + r.argv.join(' '));
      if (r.verification) console.log('    ->   ' + r.verification);
      if (r.error) console.log('    err  ' + r.error);
      console.log('');
    });
    return 0;
  }

  if (cmd === 'remediate') {
    var execute = !!args.flags.execute;
    var rcfgLoaded = configMod.load(io, configPath);
    var rcfg = rcfgLoaded.config;
    var res2 = engine.run({
      io: io, state_dir: stateDir, config_path: configPath,
      // --execute is the ONLY path that writes action history and runs
      // anything. Without it this is a dry run in every respect.
      dry_run: !execute, execute_actions: execute,
      measure: sources.measure(rcfg.disk, io), guardian_version: VERSION
    });
    if (res2.skipped) { console.log('skipped: another Guardian tick holds the lock'); return 0; }
    var rep = res2.report;
    if (json) { console.log(JSON.stringify({ remediation: rep.remediation, actions: rep.actions, posture: rep.guardian.remediation }, null, 2)); return 0; }
    console.log('MYTHOS Guardian — remediation ' + (execute ? 'EXECUTE' : 'dry run') + '\n');
    console.log('  posture: ' + rep.guardian.remediation.note);
    console.log('  host:    ' + rep.host.level + '   ' + engine.DOMAINS.map(function (d) { return d[0] + ':' + rep.domains[d].level; }).join(' '));
    console.log('');
    (rep.remediation ? rep.remediation.decisions : []).forEach(function (d) {
      console.log('  ' + (d.allowed ? 'ALLOW' : 'block') + '  ' + d.action + (d.target ? ' [' + d.target + ']' : ''));
      if (!d.allowed) console.log('         gate ' + d.gate + ': ' + d.reason);
      else console.log('         would run: ' + (d.argv || []).join(' '));
    });
    if (rep.actions && rep.actions.length) {
      console.log('\n  RESULTS');
      rep.actions.forEach(function (r) {
        console.log('   ' + r.action + '  ' + r.mode + '  ' + r.result + (r.verification ? '  (' + r.verification + ')' : '') + (r.error ? '  ERR ' + r.error : ''));
      });
    }
    if (!execute) console.log('\n  Nothing was done. Add --execute to perform the allowed actions.');
    return 0;
  }

  if (cmd === 'selftest') return selftest(io, stateDir, configPath, json);

  console.error(usage());
  return 2;
}

// Runs a scenario for N ticks with an in-memory state, always dry.
function simulateOne(io, cfg, name, ticks) {
  var s = scenarios.SCENARIOS[name];
  // A scenario may pin its own tick count when the point IS the tick count
  // (for example: one sample of evidence must not escalate).
  if (typeof s.ticks === 'number') ticks = s.ticks;
  var nowMs = Date.now();
  var state = engine.emptyState(new Date(nowMs).toISOString());
  if (s.prevState) {
    Object.keys(s.prevState).forEach(function (k) {
      if (k === 'services' && s.prevState.services.restarts) {
        var r = {};
        Object.keys(s.prevState.services.restarts).forEach(function (id) {
          r[id] = s.prevState.services.restarts[id].map(function (h) { return { at: h.at === -1 ? nowMs - 10 * 60000 : h.at, n: h.n }; });
        });
        state.services = { restarts: r };
      } else state[k] = s.prevState[k];
    });
  }
  var last = null, allFindings = [];
  // Peaks matter as much as the final state: a spike (an OOM kill) is real
  // even though the domain de-escalates once it stops recurring.
  var peak = { host: 'NORMAL' };
  engine.DOMAINS.forEach(function (d) { peak[d] = 'NORMAL'; });
  for (var i = 0; i < ticks; i++) {
    var collectors = scenarios.isOscillating(name)
      ? scenarios.oscillatingCollectors(name, cfg, nowMs + i * 120000, i)
      : scenarios.collectorsFor(name, cfg, nowMs + i * 120000);
    var out = engine.tick({
      io: io, config: cfg, state: state, now_ms: nowMs + i * 120000, dry_run: true,
      collectors: collectors, guardian_version: VERSION
    });
    state = out.state;
    last = out.report;
    peak.host = levels.max(peak.host, out.report.host.level);
    engine.DOMAINS.forEach(function (d) { peak[d] = levels.max(peak[d], out.report.domains[d].level); });
    out.report.findings.forEach(function (f) { if (allFindings.indexOf(f.kind) < 0) allFindings.push(f.kind); });
  }
  var final = {
    host: last.host.level, partial: last.host.partial, guardian: last.guardian.state,
    domains: engine.DOMAINS.reduce(function (a, d) { a[d] = last.domains[d].level; return a; }, {})
  };
  var expect = s.expect || {};
  var matches = Object.keys(expect).every(function (k) {
    if (k === 'samples') return true;
    if (k === 'host') return final.host === expect.host;
    if (k === 'guardian') return final.guardian === expect.guardian;
    if (k === 'partial') return final.partial === expect.partial;
    if (k === 'peak_host') return peak.host === expect.peak_host;
    if (k.indexOf('peak_') === 0) return peak[k.slice(5)] === expect[k];
    return final.domains[k] === expect[k];
  });
  return { scenario: name, why: s.why, ticks: ticks, expect: expect, final: final, peak: peak, matches_expectation: matches, findings: allFindings, report: last };
}

// Proves, on this host, the properties the design claims.
function selftest(io, stateDir, configPath, json) {
  var checks = [];
  function check(id, pass, detail) { checks.push({ id: id, pass: !!pass, detail: detail }); }

  // 1. The I/O layer refuses to write outside the state directory.
  var probe = ioMod.createIo({});
  probe.stateDir = stateDir;
  var escaped = null;
  try { probe.assertOwnState('/etc/passwd'); escaped = 'ALLOWED'; } catch (e) { escaped = 'refused'; }
  check('write-boundary', escaped === 'refused', 'assertOwnState("/etc/passwd") -> ' + escaped);
  check('write-boundary-traversal', (function () { try { probe.assertOwnState(path.join(stateDir, '..', 'x')); return false; } catch (e) { return true; } })(), 'traversal out of the state dir is refused');

  // 2. Only allowlisted read commands can run.
  var refusals = [['systemctl', 'restart', 'nginx'], ['systemctl', 'stop', 'erp-api'], ['docker', 'system', 'prune'], ['rm', '-rf', '/'], ['kill', '-9', '1']];
  var allRefused = refusals.every(function (a) { return ioMod.allowedCommand(a) === false; });
  check('command-allowlist', allRefused, refusals.length + ' mutating argv rejected; allowlist = ' + ioMod.READ_COMMANDS.map(function (c) { return c.join(' '); }).join(', '));
  var spawned = probe.spawn(['systemctl', 'restart', 'nginx']);
  check('command-allowlist-enforced', spawned.refused === true && spawned.status === null, 'spawn(["systemctl","restart","nginx"]) -> ' + (spawned.refused ? 'refused before exec' : 'EXECUTED'));

  // 3. The structural boundary, which holds whatever the POLICY is.
  //
  // This check used to assert observe_only === true, which conflated a
  // policy choice with a security property: it failed on any host that had
  // deliberately enabled remediation, turning a real check into noise. What
  // must be true regardless of configuration is that Guardian has no way to
  // delete anything and no way to run a command that is not allowlisted.
  var probeStruct = ioMod.createIo({});
  var noDelete = ['unlink', 'rm', 'remove', 'rmdir', 'chmod', 'chown', 'kill', 'exec']
    .every(function (k) { return typeof probeStruct[k] === 'undefined'; });
  check('no-delete-primitive', noDelete, 'io exposes no unlink, rm, rmdir, chmod, chown, kill or exec');

  var posture = engine.remediationPosture(configMod.load(io, configPath).config);
  check('posture-coherent',
    posture.observe_only === true ? posture.remediation_available === false : true,
    posture.note);

  // 4. A dry tick writes nothing.
  var cfg = configMod.load(io, configPath).config;
  var before = io.lstat(engine.paths(stateDir).state);
  var dry = engine.run({ io: io, state_dir: stateDir, config_path: configPath, dry_run: true, collectors: scenarios.collectorsFor('normal', cfg, Date.now()), guardian_version: VERSION });
  var after = io.lstat(engine.paths(stateDir).state);
  check('dry-run-writes-nothing', dry.written === false &&
    ((before === null && after === null) || (before && after && before.mtimeMs === after.mtimeMs)),
    'state.json ' + (before ? 'mtime ' + before.mtimeMs : 'absent') + ' -> ' + (after ? 'mtime ' + after.mtimeMs : 'absent'));

  // 5. Missing inputs degrade Guardian, they never read as a healthy host.
  var blind = engine.tick({ io: io, config: cfg, state: engine.emptyState(new Date().toISOString()), now_ms: Date.now(), dry_run: true, collectors: scenarios.collectorsFor('guardian-blind', cfg, Date.now()) });
  check('unknown-is-not-normal', blind.report.guardian.state === 'BLIND' && blind.report.host.partial === true,
    'all sources missing -> guardian=' + blind.report.guardian.state + ', host partial=' + blind.report.host.partial);

  // 6. Escalation cannot starve (the #283 case).
  var osc = simulateOne(io, cfg, 'oscillating-evidence', 4);
  check('no-escalation-starvation', levels.rank(osc.final.domains.disk) >= levels.rank('HIGH'),
    'evidence alternating HIGH/CRITICAL (no upstream hysteresis) -> disk=' + osc.final.domains.disk);

  // 7. A degraded signal must not silently erase a real host level.
  var deg = simulateOne(io, cfg, 'pressure-missing-under-real-pressure', 3);
  check('degraded-still-reports', deg.final.domains.memory === 'CRITICAL' && deg.final.guardian === 'DEGRADED',
    'publication missing + /proc critical -> memory=' + deg.final.domains.memory + ', guardian=' + deg.final.guardian);

  // 8. The action channel is disarmed and its allowlist excludes destruction.
  var probe2 = ioMod.createIo({});
  probe2.stateDir = stateDir;
  var disarmed = probe2.act(['npm', 'cache', 'clean', '--force']);
  check('action-channel-disarmed', disarmed.refused === true && disarmed.error === 'action_channel_disarmed',
    'an allowlisted action refuses while io.armed is false');
  var destructive = [['docker', 'system', 'prune'], ['docker', 'volume', 'prune'], ['docker', 'rm', 'x'],
                     ['systemctl', '--user', 'stop', 'x'], ['systemctl', 'stop', 'nginx'], ['rm', '-rf', '/'], ['kill', '-9', '1']];
  check('action-allowlist', destructive.every(function (a) { return ioMod.allowedAction(a) === false; }),
    destructive.length + ' destructive argv rejected; action allowlist = ' + ioMod.ACTION_COMMANDS.map(function (c) { return c.join(' '); }).join(', '));
  check('allowlists-disjoint', ioMod.ACTION_COMMANDS.every(function (a) { return ioMod.allowedCommand(a) === false; }),
    'no action command is also a read command');

  // 9. Every registered action refuses protected resources.
  var prot = actionsMod.list().every(function (a) {
    return actionsMod.refusesProtected(['systemctl', '--user', 'restart', 'erp-api.service']) !== null;
  });
  check('protected-resources', prot && actionsMod.refusesProtected(['docker', 'rm', 'idauto-postgres']) !== null,
    'PROTECTED refuses ERP, databases, backups, credentials and repositories');

  var passed = checks.filter(function (c) { return c.pass; }).length;
  if (json) { console.log(JSON.stringify({ version: VERSION, checks: checks, passed: passed, total: checks.length }, null, 2)); }
  else {
    console.log('MYTHOS Guardian ' + VERSION + ' — boundary self test\n');
    checks.forEach(function (c) { console.log('  ' + (c.pass ? 'PASS' : 'FAIL') + '  ' + c.id + (' '.repeat(Math.max(1, 28 - c.id.length))) + c.detail); });
    console.log('\n' + passed + '/' + checks.length + ' checks passed.');
  }
  return passed === checks.length ? 0 : 1;
}

if (require.main === module) process.exit(main(process.argv.slice(2)));
module.exports = { main: main, parseArgs: parseArgs, simulateOne: simulateOne, VERSION: VERSION };
