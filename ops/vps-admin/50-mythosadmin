# Mythos VPS administrator — controlled sudo for Mythos operations only.
#
# Scope is deliberately narrow. It contains NO file-copier, NO interpreter,
# NO editor, NO container runtime and NO arbitrary systemctl/unit control —
# each of those would be equivalent to blanket root and would defeat the
# governance boundary (mythosadmin must not be able to read
# /etc/mythos/governance.key or install/alter /usr/local/lib/mythos code).
#
# mythos-deploy is root-owned 0755 (not writable by mythosadmin) and is itself
# bounded: it resolves targets from a fixed registry and runs git as `deploy`.
#
# The alias names are intentionally namespaced to mythosadmin so this fragment
# cannot collide with an older or independently-managed sudoers fragment on
# the VPS. A standalone visudo check can pass while the global include fails
# when an alias name is duplicated elsewhere.

Cmnd_Alias MYTHOSADMIN_DEPLOY  = /usr/local/sbin/mythos-deploy, /usr/local/sbin/mythos-deploy *
Cmnd_Alias MYTHOSADMIN_NGINX   = /usr/sbin/nginx -t, /usr/bin/systemctl reload nginx, /usr/bin/systemctl status nginx, /usr/bin/systemctl is-active nginx
Cmnd_Alias MYTHOSADMIN_CERT    = /usr/bin/certbot
Cmnd_Alias MYTHOSADMIN_OBSERVE = /usr/local/sbin/mythos-logs

mythosadmin ALL=(root) NOPASSWD: MYTHOSADMIN_DEPLOY, MYTHOSADMIN_NGINX, MYTHOSADMIN_CERT, MYTHOSADMIN_OBSERVE
