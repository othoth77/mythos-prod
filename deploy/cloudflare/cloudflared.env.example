# Mythos OS — Cloudflare Tunnel environment variables
# ====================================================
# WARNING: The real values for these variables must NEVER be committed to Git.
# Store them only in Coolify encrypted environment variables or an approved
# secret manager. This file contains placeholder values only.
#
# If any real value is found in this file or in Git history, rotate the
# corresponding credential immediately in the Cloudflare Zero Trust dashboard.

# Cloudflare Tunnel token (from Zero Trust dashboard → Tunnels → Configure)
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Tunnel name (logical identifier in Zero Trust dashboard)
CLOUDFLARE_TUNNEL_NAME=

# Cloudflare Account ID (found in dashboard URL or account settings)
CLOUDFLARE_ACCOUNT_ID=