# Mythos ERP API — user-level systemd unit (deploy user manager, linger enabled).
#
# Install (as deploy, from the main checkout):
#   install -m 0644 sites/erp.mythosprod.xyz/deploy/erp-api.user.service ~/.config/systemd/user/erp-api.service
#   systemctl --user daemon-reload && systemctl --user enable --now erp-api
#
# Same shape and hardening set as the sibling units that run green on this host
# (mythos-wp, mythos-command-center, ssangyong-storefront): user scope because
# `deploy` cannot write /etc/systemd/system; no ProtectKernelTunables /
# ProtectClock / RestrictNamespaces (capability drop refused in user scope);
# no MemoryDenyWriteExecute (V8 JIT).
#
# Phase 15 correction: `systemd-analyze --user security erp-api` and a direct
# `systemd-run --user` reproduction (same properties, real filesystem writes
# under /home/deploy/... succeeded) both show ProtectHome= does NOT take
# effect in this deploy-user session scope — a systemd limitation of
# unprivileged --user managers, not a config mistake here. It is kept
# declared (so the day it becomes effective in this scope, or the unit is
# ever promoted to a system-level service, the intended boundary is already
# correct) but must not be read as an active control today. Getting REAL
# enforcement means running this as a root-owned /etc/systemd/system unit
# instead — a bigger change (service ownership moves from deploy to root)
# deliberately not made in this pass; see docs/AI_HANDOVER.md Phase 15.
#
# Runtime role is erp_app ONLY. The EnvironmentFile carries ERP_DATABASE_URL =
# the erp_app connection string (server.js refuses to start as any other role
# and /api/v1/health reports the role it actually authenticated as).
# The process binds 127.0.0.1:${ERP_API_PORT} only; nginx is the only public
# surface and is a separate, deliberate step (Phase 15).

[Unit]
Description=Mythos ERP API — authenticated multi-tenant boundary over PostgreSQL (erp_app runtime)
Documentation=https://github.com/othoth77/mythos-prod
After=network-online.target
# Boot-order retries (2026-09-18). The ExecStartPre guard below normally makes
# a database wait unnecessary, but if Postgres is slower to appear than that
# guard's timeout, the unit must be able to keep retrying for several minutes
# instead of giving up after 5 attempts in 300 s. 20 starts / 600 s still
# bounds a genuine restart loop rather than letting one run forever.
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/home/deploy/projects/mythos-prod/sites/erp.mythosprod.xyz/api

# 0600, deploy-owned, outside git: ERP_DATABASE_URL (erp_app), ERP_API_PORT.
EnvironmentFile=/home/deploy/deployments/erp-api/.env
Environment=NODE_ENV=production

# Boot-order guard (2026-09-18). This is a user unit; PostgreSQL is the
# idauto-postgres Docker container owned by the SYSTEM manager, and a user unit
# cannot order itself After= a system unit. So the wait is expressed here
# instead: block until the database accepts TCP, then start. Host and port come
# from ERP_DATABASE_URL above, so this cannot drift from the real target.
# Exit 1 (timeout) is transient and is deliberately NOT in
# RestartPreventExitStatus, so Restart=on-failure retries the whole unit.
ExecStartPre=/home/deploy/projects/mythos-prod/sites/erp.mythosprod.xyz/deploy/wait-for-db.sh
ExecStart=/usr/bin/node /home/deploy/projects/mythos-prod/sites/erp.mythosprod.xyz/api/server.js

Restart=on-failure
RestartSec=5s
# Exit 3 = the runtime role is not erp_app: a configuration error that no
# retry can fix, so it is never restarted.
# Exit 2 = "database not reachable at start" is NOT prevented (2026-09-18).
# server.js exits 2 on ANY failure of its start query, which includes Postgres
# accepting TCP but still in crash recovery ("the database system is starting
# up") after an unclean shutdown. wait-for-db.sh only proves TCP, and the port
# is published through docker-proxy, so that window is real. With 2 prevented
# the unit stayed dead after the 15:28 reboot; now it retries, still bounded
# by StartLimitBurst/StartLimitIntervalSec above.
RestartPreventExitStatus=3

# Resource ceiling: idle RSS is ~60 MiB; scrypt login hashing peaks at ~128 MiB
# per concurrent attempt (N=2^17). 384 MiB caps a burst without starving the host.
MemoryMax=384M
MemoryHigh=300M

# --- Hardening (the set that runs green in user scope on this host) --------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The API's only filesystem write target is the document store (Phase 12).
# Declared explicitly rather than left to ProtectHome= (see the note above on
# why that directive alone cannot be trusted in this scope) — the same
# pattern mythos-command-center already uses for its one writable directory.
# The leading `-` marks the path optional: the directory is lazily created
# by modules/documents.js on the first real upload and does not exist yet in
# production, and ReadWritePaths on a missing, non-optional path fails the
# unit's own start.
ReadWritePaths=-/home/deploy/deployments/erp-api/documents

StandardOutput=journal
StandardError=journal
SyslogIdentifier=erp-api

[Install]
WantedBy=default.target
