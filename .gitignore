# Runtime data — NEVER commit
appdata/
appdata/backups/
documents/

# Credentials — NEVER commit
google_config.php
ACCES.txt

# Restore snapshots
data/restore-*.js

# Logs & temp
*.log
*.tmp
*.bak
/tmp/

# OS artefacts
.DS_Store
Thumbs.db

# Node dependencies — NEVER commit (introduced IDA-2C, projects/idauto/package.json)
node_modules/
.env
!.env.example

# Orchestrator test fixtures (sandbox-writable fallback root)
.test-fixtures/

# oth-knowledge runtime store (never commit knowledge data)
projects/oth-knowledge/data/

# Graphify generated graphs are runtime artifacts, never source (graphify skill rule)
graphify-out/

# Python bytecode cache (ops/hostops/mythos-hostops-daemon.py, HOSTOPS-2R)
__pycache__/
*.pyc
